# ====================================================================================
# RÁPIDO E SEGURO — Variáveis de Ambiente
# Copie este ficheiro para ".env" e preencha com os seus valores reais.
# NUNCA commite o ficheiro ".env" para o repositório!
# ====================================================================================

# ── BASE DE DADOS ──────────────────────────────────────────────────────────────────

# OPÇÃO A: SQLite (desenvolvimento local) — padrão actual
DATABASE_URL="file:./dev.db"

# OPÇÃO B: PostgreSQL via Supabase (recomendado para produção)
# Para migrar para PostgreSQL:
#   1. Crie um projeto em https://supabase.com
#   2. Vá a Settings > Database > Connection String
#   3. Copie a "Transaction pooler" connection string (porta 6543) para DATABASE_URL
#   4. Copie a "Direct connection" string (porta 5432) para DIRECT_URL
#   5. Altere o provider em prisma/schema.prisma de "sqlite" para "postgresql"
#   6. Execute: npx prisma db push
#
# DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ── AUTENTICAÇÃO JWT ────────────────────────────────────────────────────────────────

# OBRIGATÓRIO em produção! Gere uma chave segura com:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_SEGURA_MINIMO_32_CARACTERES"

# ── SUPABASE (opcional — apenas se usar autenticação Supabase) ──────────────────────
# NEXT_PUBLIC_SUPABASE_URL="https://XXXX.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGc..."

# ── APLICAÇÃO ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Rápido e Seguro — Gestão de Vendas"
